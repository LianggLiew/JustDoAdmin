<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Required meta tags -->
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>JustDo Admin</title>
    <!-- inject:css -->
    <link rel="stylesheet" href="~/themes/assets/css/vertical-layout-light/style.css">
    <!-- endinject -->
    <link rel="shortcut icon" href="~/themes/assets/images/favicon.png" />
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-light border-bottom px-5">
      <a class="navbar-brand" href="#">
        <img src="~/themes/assets/images/logo.svg" alt="JustDo" />
      </a>
      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto d-flex align-items-center">
          <li class="nav-item">
            <a
              class="nav-link px-3"
              href="https://demo.bootstrapdash.com/justdo/docs/documentation.html"
              target="_blank">
              Documentation
            </a>
          </li>
        </ul>
      </div>
    </nav>
    <div class="container-fluid px-0">
      <div class="content-wrapper bg-white">
        <div>
          <h3 class="mt-3 mb-4 text-center fw-light">
            JustDo Bootstrap 5 admin template comes with a variety of layouts
            and options
          </h3>
          <h2 class="text-center mb-5 fw-light">Choose a layout</h2>
          <div class="row">
            <div class="col-md-4 grid-margin">
              <div class="p-3">
                <a
                  href="~/themes/vertical-default-light/index.html"
                  target="_blank">
                  <img
                    src="~/themes/assets/images/demo/vertical-default.png"
                    alt="vertical menu"
                    class="mw-100 mb-4 shadow-lg" />
                  <h4 class="text-dark">Vertical - light</h4>
                </a>
              </div>
            </div>
            <div class="col-md-4 grid-margin">
              <div class="p-3">
                <a
                  href="~/themes/vertical-default-dark/index.html"
                  target="_blank">
                  <img
                    src="~/themes/assets/images/demo/vertical-dark.png"
                    alt="vertical menu"
                    class="mw-100 mb-4 shadow-lg" />
                  <h4 class="text-dark">Vertical - dark</h4>
                </a>
              </div>
            </div>
            <div class="col-md-4 grid-margin">
              <div class="p-3">
                <a
                  href="~/themes/horizontal-default-light/index.html"
                  target="_blank">
                  <img
                    src="~/themes/assets/images/demo/horizontal-menu-light.png"
                    alt="horizontal"
                    class="mw-100 mb-4 shadow-lg" />
                  <h4 class="text-dark">Horizontal - light</h4>
                </a>
              </div>
            </div>
            <div class="col-md-4 grid-margin">
              <div class="p-3">
                <a
                  href="~/themes/horizontal-default-dark/index.html"
                  target="_blank">
                  <img
                    src="~/themes/assets/images/demo/horizontal-menu-dark.png"
                    alt="horizontal"
                    class="mw-100 mb-4 shadow-lg" />
                  <h4 class="text-dark">Horizontal - dark</h4>
                </a>
              </div>
            </div>
            <div class="col-md-4 grid-margin">
              <div class="p-3">
                <a
                  href="~/themes/vertical-dark-sidebar/index.html"
                  target="_blank">
                  <img
                    src="~/themes/assets/images/demo/dark-sidebar.png"
                    alt="dark sidebar"
                    class="mw-100 mb-4 shadow-lg" />
                  <h4 class="text-dark">Dark menu</h4>
                </a>
              </div>
            </div>
            <div class="col-md-4 grid-margin">
              <div class="p-3">
                <a href="~/themes/vertical-boxed/index.html" target="_blank">
                  <img
                    src="~/themes/assets/images/demo/boxed-layout.png"
                    alt="boxed layout"
                    class="mw-100 mb-4 shadow-lg" />
                  <h4 class="text-dark">Boxed layout</h4>
                </a>
              </div>
            </div>
            <div class="col-md-4 grid-margin">
              <div class="p-3">
                <a href="~/themes/vertical-icon-menu/index.html" target="_blank">
                  <img
                    src="~/themes/assets/images/demo/icon-menu.png"
                    alt="icon sidebar"
                    class="mw-100 mb-4 shadow-lg" />
                  <h4 class="text-dark">Icon menu</h4>
                </a>
              </div>
            </div>
            <div class="col-md-4 grid-margin">
              <div class="p-3">
                <a href="~/themes/vertical-compact/index.html" target="_blank">
                  <img
                    src="~/themes/assets/images/demo/compact-menu.png"
                    alt="compact sidebar"
                    class="mw-100 mb-4 shadow-lg" />
                  <h4 class="text-dark">Compact menu</h4>
                </a>
              </div>
            </div>
            <div class="col-md-4 grid-margin">
              <div class="p-3">
                <a href="~/themes/vertical-fixed/index.html" target="_blank">
                  <img
                    src="~/themes/assets/images/demo/fixed-menu.png"
                    alt="fixed sidebar"
                    class="mw-100 mb-4 shadow-lg" />
                  <h4 class="text-dark">Fixed sidebar</h4>
                </a>
              </div>
            </div>
            <div class="col-md-4 grid-margin">
              <div class="p-3">
                <a
                  href="~/themes/vertical-hidden-toggle/index.html"
                  target="_blank">
                  <img
                    src="~/themes/assets/images/demo/toggle-menu.png"
                    alt="toggle sidebar"
                    class="mw-100 mb-4 shadow-lg" />
                  <h4 class="text-dark">Toggle sidebar</h4>
                </a>
              </div>
            </div>
            <div class="col-md-4 grid-margin">
              <div class="p-3">
                <a
                  href="~/themes/vertical-toggle-overlay/index.html"
                  target="_blank">
                  <img
                    src="~/themes/assets/images/demo/toggle-overlay-menu.png"
                    alt="dark sidebar"
                    class="mw-100 mb-4 shadow-lg" />
                  <h4 class="text-dark">Sidebar overlay</h4>
                </a>
              </div>
            </div>
            <div class="col-md-6 col-lg-4 grid-margin">
              <div class="h-100 d-flex flex-column p-3">
                <a
                  href="#"
                  class="flex-grow-1 d-flex align-content-center justify-content-center flex-column">
                  <i class="mdi mdi-dots-horizontal h1 text-center"></i>
                  <h4 class="text-dark text-center">Coming soon</h4>
                </a>
              </div>
            </div>
          </div>
          <h4 class="mt-3 mb-5 text-center">Ready to use widgets</h4>
          <div class="row">
            <div class="col-md-6 col-lg-4 grid-margin">
              <div class="p-3">
                <a
                  href="~/themes/vertical-default-light/pages/apps/calendar.html"
                  target="_blank">
                  <img
                    src="~/themes/assets/images/demo/calendar.png"
                    alt="calendar"
                    class="mw-100 mb-4 shadow-lg" />
                  <h4 class="text-dark">Calendar</h4>
                </a>
              </div>
            </div>
            <div class="col-md-6 col-lg-4 grid-margin">
              <div class="p-3">
                <a
                  href="~/themes/vertical-default-light/pages/samples/login-2.html"
                  target="_blank">
                  <img
                    src="~/themes/assets/images/demo/login.png"
                    alt="auth"
                    class="mw-100 mb-4 shadow-lg" />
                  <h4 class="text-dark">Auth screen</h4>
                </a>
              </div>
            </div>
            <div class="col-md-6 col-lg-4 grid-margin">
              <div class="p-3">
                <a
                  href="~/themes/vertical-default-light/pages/samples/pricing-table.html"
                  target="_blank">
                  <img
                    src="~/themes/assets/images/demo/pricing.png"
                    alt="pricing"
                    class="mw-100 mb-4 shadow-lg" />
                  <h4 class="text-dark">Pricing table</h4>
                </a>
              </div>
            </div>
            <div class="col-md-6 col-lg-4 grid-margin">
              <div class="p-3">
                <a
                  href="~/themes/vertical-default-light/pages/apps/email.html"
                  target="_blank">
                  <img
                    src="~/themes/assets/images/demo/email.png"
                    alt="email"
                    class="mw-100 mb-4 shadow-lg" />
                  <h4 class="text-dark">Email</h4>
                </a>
              </div>
            </div>
            <div class="col-md-6 col-lg-4 grid-margin">
              <div class="p-3">
                <a
                  href="~/themes/vertical-default-light/pages/samples/portfolio.html"
                  target="_blank">
                  <img
                    src="~/themes/assets/images/demo/portfolio.png"
                    alt="portfolio"
                    class="mw-100 mb-4 shadow-lg" />
                  <h4 class="text-dark">Portfolio</h4>
                </a>
              </div>
            </div>
            <div class="col-md-6 col-lg-4 grid-margin">
              <div class="h-100 d-flex flex-column p-3">
                <a
                  href="~/themes/vertical-default-light/pages/widgets/widgets.html"
                  target="_blank"
                  class="flex-grow-1 d-flex align-content-center justify-content-center flex-column">
                  <i class="mdi mdi-dots-horizontal h1 text-center"></i>
                  <h4 class="text-dark text-center">More</h4>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
